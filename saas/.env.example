# ── Lemon Squeezy (required for paid tier) ──────────────────────
# Get API key from https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Get store ID from your store URL: app.lemonsqueezy.com/store/{STORE_ID}
LEMONSQUEEZY_STORE_ID=

# Variant IDs (get from Products → {Product} → Variants after creating products)
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_ANNUAL=
LEMONSQUEEZY_VARIANT_TEAM_MONTHLY=
LEMONSQUEEZY_VARIANT_TEAM_ANNUAL=

# ── Public URL (used in checkout success URLs) ──────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Waitlist email storage (optional) ───────────────────────────
# If set, waitlist emails are appended to this file. Otherwise just logged.
WAITLIST_FILE=
