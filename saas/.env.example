# ── Stripe (required for paid tier) ──────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── Public URL (used in Stripe Checkout success/cancel URLs) ──────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Waitlist email storage (optional) ─────────────────────────────
# If set, waitlist emails are appended to this file. Otherwise just logged.
WAITLIST_FILE=

# ── Stripe Price IDs (configure after creating products in Stripe) ──
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_xxx
STRIPE_PRICE_PROFESSIONAL_ANNUAL=price_xxx
STRIPE_PRICE_TEAM_MONTHLY=price_xxx
STRIPE_PRICE_TEAM_ANNUAL=price_xxx
