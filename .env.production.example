# ════════════════════════════════════════════════════════════════════
#  Loop Zero — Production Environment Variables
# ════════════════════════════════════════════════════════════════════
#  Copy this to .env.production on your deploy machine, OR set these
#  as GitHub Actions secrets (see .github/workflows/deploy.yml).
#
#  Where to get each key:
#    VERCEL_TOKEN       — https://vercel.com/account/tokens (create one)
#    VERCEL_SCOPE       — your Vercel team slug, or leave blank for personal
#    LLM_API_KEY        — https://platform.openai.com/api-keys OR https://console.anthropic.com
#    STRIPE_SECRET_KEY  — https://dashboard.stripe.com/apikeys
#    STRIPE_WEBHOOK_SECRET — set up after first deploy, see saas/README.md
#    STRIPE_PRICE_*     — https://dashboard.stripe.com/products
#    NEXT_PUBLIC_SITE_URL — your production domain (e.g. https://loopzero.co)
# ════════════════════════════════════════════════════════════════════

# Vercel (required)
VERCEL_TOKEN=
VERCEL_SCOPE=

# LLM provider (OpenAI or Anthropic)
LLM_PROVIDER=openai
LLM_API_KEY=

# Stripe (saas app only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=

# Public URL
NEXT_PUBLIC_SITE_URL=https://loopzero.co
